<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="18dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="3dp"
    app:strokeColor="#14000000"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Main Card Section (Image + Content + Expand Arrow) ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="14dp">

            <!-- AI Animal Image (Left Side) -->
            <FrameLayout
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:id="@+id/animalImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_tiger_placeholder" />
            </FrameLayout>

            <!-- Content Section (Middle - Expandable) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="top">

                <!-- Animal Name Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_name_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/animalName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Animal"
                        android:textColor="#9E5E2A"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Description -->
                <TextView
                    android:id="@+id/animalDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text_grey"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="6dp" />

                <!-- Habitat row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_home_mini"
                        app:tint="#9E5E2A" />

                    <TextView
                        android:id="@+id/animalHabitat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:alpha="0.85"
                        android:textColor="#9E5E2A"
                        android:textSize="11sp"
                        android:textStyle="italic" />
                </LinearLayout>
            </LinearLayout>

            <!-- Expand Chevron (Right Side) -->
            <ImageView
                android:id="@+id/expandChevron"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_soft_card"
                android:clickable="true"
                android:contentDescription="Expand details"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/green_primary" />
        </LinearLayout>

        <!-- ── Expanded Content Section ── -->
        <LinearLayout
            android:id="@+id/tipsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="0dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <!-- Divider -->
            <View
                android:id="@+id/tipsDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"
                android:background="#1A000000" />

            <!-- Co-existence tips header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="⚠ Safety Tips"
                android:textColor="@color/green_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Tips list -->
            <TextView
                android:id="@+id/tipsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/text_grey"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
